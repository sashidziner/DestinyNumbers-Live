# Production build overrides (Vite auto-loads only during `npm run build`).
# Kept out of dev so local `npm run dev` still hits the live /demo/ mailer via .env.

# Empty → Contact.tsx falls back to `${BASE_URL}send-mail.php` = `/send-mail.php`,
# served from the same origin by the PHP file next to index.html.
VITE_MAILER_URL=
